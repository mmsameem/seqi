# SEQI Platform Environment Configuration
# Copy this file to .env before starting the server

NODE_ENV=production
PORT=3000

# Secret key used for signing JWT tokens (Must be at least 32 characters long in production)
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# Path to the SQLite database file
DATABASE_PATH=database.db

# Path to directory where user uploads are saved
UPLOAD_DIR=uploads

# Bootstrap administrator credentials (created on initial launch)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-this-with-a-strong-password-min-8-chars
